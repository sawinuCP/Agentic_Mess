# Copy to services/api/.env and adjust as needed. Every variable is optional;
# defaults match docker-compose.yml (host ports are offset to avoid conflicts
# with locally installed PostgreSQL/Redis on Windows).
HARNESS_ENVIRONMENT=dev
HARNESS_LOG_LEVEL=INFO
HARNESS_DATABASE_URL=postgresql+psycopg://harness:harness@localhost:15432/harness
HARNESS_REDIS_URL=redis://localhost:16379/0
HARNESS_NATS_URL=nats://localhost:14222
HARNESS_READINESS_TIMEOUT_SECONDS=2.0
HARNESS_REQUIRE_REDIS=false
HARNESS_REQUIRE_NATS=false
HARNESS_OTEL_ENABLED=false
HARNESS_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
HARNESS_OTEL_SERVICE_NAME=ai-harness-api

# Durable execution (Temporal; compose profile `temporal`)
HARNESS_TEMPORAL_ENABLED=false
HARNESS_TEMPORAL_ADDRESS=localhost:7233
HARNESS_TEMPORAL_TASK_QUEUE=ai-harness-tasks

# Scheduler (Phase 4, FR-011/PERF-003)
HARNESS_SCHEDULER_ENABLED=true
HARNESS_SCHEDULER_MAX_CONCURRENCY=4
# JSON per-role caps, e.g. {"implementer": 2, "tester": 1}
HARNESS_SCHEDULER_ROLE_LIMITS=
# Bounded recursion for spawned agents/tasks (FR-007)
HARNESS_SPAWN_MAX_DEPTH=2

# Message delivery fan-out (FR-010; NATS is in the default compose stack)
HARNESS_NATS_DELIVERY_ENABLED=false
HARNESS_NATS_DELIVERY_STREAM=harness-messages
HARNESS_NATS_DELIVERY_SUBJECT_PREFIX=harness.msg

# Execution plane (Phase 6, spec §19)
HARNESS_RUNTIME_BACKEND=local
HARNESS_DOCKER_IMAGE=python:3.11-slim
HARNESS_DOCKER_NETWORK=none
HARNESS_DOCKER_MEMORY=512m
HARNESS_DOCKER_CPUS=1.0
HARNESS_EXEC_TIMEOUT_CAP_SECONDS=900
HARNESS_EXEC_MAX_CONCURRENT_PER_PROJECT=2
HARNESS_PORT_RANGE_LOW=21000
HARNESS_PORT_RANGE_HIGH=21999
HARNESS_PORT_TTL_SECONDS=3600

# Browser debugging (Phase 7, FR-020) — requires: playwright install chromium
HARNESS_BROWSER_ENABLED=true
HARNESS_BROWSER_MAX_SESSIONS=5

# MCP gateway (Phase 7, FR-021) — opt-in; servers execute arbitrary commands
HARNESS_MCP_ENABLED=false
HARNESS_MCP_CONFIG_PATH=
HARNESS_MCP_TIMEOUT_SECONDS=60

# Web research (Phase 7, FR-022)
HARNESS_RESEARCH_ENABLED=true
# SSRF posture (Wave 1): private/loopback destinations are DENIED by default.
# Set to true ONLY for local development against localhost test servers.
HARNESS_RESEARCH_PRIVATE_HOSTS_ALLOWED=false
HARNESS_RESEARCH_MAX_BYTES=2000000
HARNESS_RESEARCH_TIMEOUT_SECONDS=30

# Security (Wave 1) — see docs/OPERATIONS.md
# API bearer token. Empty = auth disabled, which is only acceptable for the
# loopback-only local posture (startup refuses non-loopback binds without a
# token). NEVER commit a real token; never log or return it.
HARNESS_API_TOKEN=
# Server bind host for launchers (uvicorn --host). Keep 127.0.0.1 unless you
# intentionally expose the API and set a token.
HARNESS_HOST=127.0.0.1
# CORS allow-list (comma-separated origins; no wildcard)
HARNESS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,https://tauri.localhost
# Extra env var names agent/tool subprocesses may inherit (comma-separated).
# Sensitive-named variables are never inherited; a tool that genuinely needs a
# secret receives it through explicit per-call overrides instead.
HARNESS_AGENT_ENV_ALLOW=

